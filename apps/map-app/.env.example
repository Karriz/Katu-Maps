# Digitransit production API subscription key.
VITE_DIGITRANSIT_SUBSCRIPTION_KEY=

# Open Charge Map identifying key from https://openchargemap.org (My apps).
# Required to show the charging stations layer. Embedded in the browser build.
VITE_OPENCHARGEMAP_API_KEY=

# Optional Open-Meteo host for viewed-location weather. No key required.
VITE_OPENMETEO_ENDPOINT=https://api.open-meteo.com

# Optional public-service overrides. Values are embedded in the browser build;
# do not put secret credentials here.
VITE_API_CLIENT_ID=katu-maps
VITE_PHOTON_ENDPOINT=https://photon.komoot.io/api
VITE_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
VITE_VALHALLA_ENDPOINT=https://valhalla1.openstreetmap.de/route
VITE_OSRM_ENDPOINT=
VITE_TRANSITOUS_API_ROOT=https://api.transitous.org/api/v6
VITE_TRANSITOUS_ROUTES_ENDPOINT=https://api.transitous.org/api/experimental/map/routes
VITE_DIGITRANSIT_ENDPOINT=https://api.digitransit.fi/routing/v2/finland/gtfs/v1
VITE_DIGITRAFFIC_ROAD_ENDPOINT=https://tie.digitraffic.fi
VITE_DIGITRAFFIC_WEATHERCAM_ENDPOINT=https://weathercam.digitraffic.fi
VITE_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
VITE_OPENCHARGEMAP_ENDPOINT=https://api.openchargemap.io/v3
VITE_TRANSIT_TRIP_REFRESH_MS=15000
