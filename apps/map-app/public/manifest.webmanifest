{
  "name": "Katu Maps",
  "short_name": "Katu Maps",
  "description": "Explore places, public transport, and routes in an open 3D map.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#74c8f4",
  "theme_color": "#17344b",
